# From Supabase: Project Settings → API (Data API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Push notifications (optional): the public key from
# `npx web-push generate-vapid-keys` (docs/setup.md). Empty = off.
VITE_VAPID_PUBLIC_KEY=
