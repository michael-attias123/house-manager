{
  "uid": "hm-jobs",
  "title": "House manager: jobs and notifications",
  "description": "Price ingest, GitHub Actions workflows, the notification outbox and send-push.",
  "tags": [
    "house-manager"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "refresh": "15m",
  "schemaVersion": 41,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "House manager",
      "type": "dashboards",
      "tags": [
        "house-manager"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Ingest runs, 14 days",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select started_at, finished_at, status, duration_s from monitoring.ingest_runs where started_at > now() - interval '14 days' order by started_at desc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": {
                  "color": "green",
                  "index": 0
                },
                "partial": {
                  "color": "orange",
                  "index": 1
                },
                "failed": {
                  "color": "red",
                  "index": 2
                },
                "running": {
                  "color": "blue",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingest duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select finished_at as time, duration_s as duration from monitoring.ingest_runs where $__timeFilter(finished_at) and finished_at is not null order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Items per chain",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select finished_at as time, chain_id as metric, items from monitoring.ingest_chain_runs where $__timeFilter(finished_at) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failed stores per chain",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select finished_at as time, chain_id as metric, stores_failed from monitoring.ingest_chain_runs where $__timeFilter(finished_at) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Last run: seconds per chain",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "description": "OTel gauges sent once at the end of each ingest run (job house-ingest), hence last_over_time.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (chain) (last_over_time(house_ingest_chain_seconds[26h]))",
          "editorMode": "code",
          "legendFormat": "{{chain}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last run status",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 8,
        "y": 16
      },
      "description": "ok, partial, failed or error: the current status is 1, the others 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (status) (last_over_time(house_ingest_run_status[26h])) == 1",
          "editorMode": "code",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Workflows: last run",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "description": "From telemetry.yml (job gha-telemetry): the last completed run of prices, venues, db-migrate and infra within 8 days (venues is weekly).",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (workflow) (last_over_time(gha_workflow_last_duration_seconds[8d]))",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (workflow, conclusion) (last_over_time(gha_workflow_last_conclusion[8d])) == 1",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #B": true
            },
            "renameByName": {
              "Value #A": "seconds"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Push outbox per hour",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select hour as time, sum(queued) as queued, sum(sent) as sent, sum(gave_up) as gave_up, sum(expired) as expired from monitoring.outbox_hourly where $__timeFilter(hour) group by hour order by hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Push latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "description": "sent_at - greatest(send_after, created_at), so quiet hours do not count.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select hour as time, max(p50_latency_s) as p50, max(p95_latency_s) as p95 from monitoring.outbox_hourly where $__timeFilter(hour) group by hour order by hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Push per kind, 24 h",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select kind, sum(queued) as queued, sum(sent) as sent, sum(gave_up) as gave_up, sum(expired) as expired from monitoring.outbox_hourly where hour > now() - interval '24 hours' group by kind order by kind"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Outbox now",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 31
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select due_pending, oldest_due_age_s, gave_up_24h, devices, devices_without_success_30d from monitoring.outbox_now"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "send-push run duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "queryType": "traceql",
          "query": "{ name = \"send-push.run\" } | quantile_over_time(duration, .5, .95)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Push service responses by host",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "description": "Push service host (fcm.googleapis.com, web.push.apple.com, ...) and HTTP status.",
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "queryType": "traceql",
          "query": "{ name = \"deliver\" } | count_over_time() by (span.push.host, span.http.response.status_code)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
