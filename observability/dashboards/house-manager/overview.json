                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "quantile_over_time(0.75, {app=\"house-manager\"} |= \"type=web-vitals\" | logfmt | kind=\"measurement\" | app_environment=\"production\" | lcp != \"\" | unwrap lcp [24h]) by (app_name)",
                        "legendFormat": "LCP ms",
                        "queryType": "instant"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "quantile_over_time(0.75, {app=\"house-manager\"} |= \"type=web-vitals\" | logfmt | kind=\"measurement\" | app_environment=\"production\" | inp != \"\" | unwrap inp [24h]) by (app_name)",
                        "legendFormat": "INP ms",
