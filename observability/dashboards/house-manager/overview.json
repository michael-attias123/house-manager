                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select coalesce(sum(queued), 0) as queued, coalesce(sum(sent), 0) as sent, coalesce(sum(gave_up), 0) as gave_up, coalesce(sum(expired), 0) as expired from monitoring.outbox_hourly where hour \u003e now() - interval '24 hours'"
