      "panel-13": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max(grafanacloud_instance_active_series) / 10000 or vector(0)",
                        "instant": true,
                        "legendFormat": "Metrics: active series / 10k",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(avg_over_time(grafanacloud_logs_instance_bytes_received_per_second[24h])) * 86400 * 30 / 50e9 or vector(0)",
                        "instant": true,
                        "legendFormat": "Logs: projected GB / 50",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-usage"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(avg_over_time(grafanacloud_traces_instance_bytes_received_per_second[24h])) * 86400 * 30 / 50e9 or vector(0)",
                        "instant": true,
                        "legendFormat": "Traces: projected GB / 50",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "(\r\n  count(max by (job, probe) (sm_check_info{frequency=\"300000\"})) * 8640\r\n+ (count(max by (job, probe) (sm_check_info{frequency=\"900000\"})) or vector(0)) * 2880\r\n) / 100000",
                        "instant": true,
                        "legendFormat": "Synthetic checks: projected executions / 100k",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "D"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(sum by (session_id) (count_over_time({app=\"house-manager\"} | logfmt [24h]))) * 30 / 50000 or vector(0)",
                        "legendFormat": "Faro: projected sessions / 50k",
                        "queryType": "instant"
                      },
                      "version": "v0"
                    },
                    "refId": "E"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Monthly projection from the last 24 hours (active series: current). Alert FreeTierBudget fires above 80%.",
