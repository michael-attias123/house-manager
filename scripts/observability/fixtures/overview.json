{
  "uid": "hm-overview",
  "title": "House manager: overview",
  "description": "Is it up, is the data fresh, are we inside the free limits. Source: observability/dashboards in git.",
  "tags": [
    "house-manager"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 41,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "House manager",
      "type": "dashboards",
      "tags": [
        "house-manager"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime, 7 days",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "description": "Share of successful Synthetic Monitoring checks per job over the last 7 days. send-push succeeds when it answers 401.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "avg by (job) (avg_over_time(probe_success{job=~\"app|supabase-auth|send-push\"}[7d]))",
          "editorMode": "code",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Check latency p95",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "description": "p95 of the probe duration per check, over a sliding hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (job) (quantile_over_time(0.95, probe_duration_seconds{job=~\"app|supabase-auth|send-push\"}[1h]))",
          "editorMode": "code",
          "legendFormat": "{{job}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hours since the last good price run",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "description": "The daily ingest runs around 06:17. Orange after 26 hours, red after 30 (alert PriceDataStale).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(extract(epoch from now() - max(finished_at)) / 3600, 9999) as hours from monitoring.ingest_runs where status in ('ok', 'partial') and finished_at is not null"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 26
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Last price run per chain",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "description": "The latest ingest run, one row per chain.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select chain_id as chain, finished_at, stores, stores_failed, items, chain_error from monitoring.ingest_chain_runs where run_id = (select max(run_id) from monitoring.ingest_chain_runs) order by chain_id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Push, last 24 h",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "description": "Notification outbox rows in the last 24 hours, all kinds.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(queued), 0) as queued, coalesce(sum(sent), 0) as sent, coalesce(sum(gave_up), 0) as gave_up, coalesce(sum(expired), 0) as expired from monitoring.outbox_hourly where hour > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Oldest due push",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "description": "Age of the oldest due, unsent row. Rows held by quiet hours are not due. Red after 30 minutes (alert PushDeliveryProblem).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(oldest_due_age_s, 0) as oldest_due from monitoring.outbox_now"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Push delivery p95, 24 h",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 12
      },
      "description": "The worst hourly p95 of sent_at - greatest(send_after, created_at).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select max(p95_latency_s) as worst_hourly_p95 from monitoring.outbox_hourly where hour > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Database size",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 12
      },
      "description": "Supabase Free allows 500 MB. Alert DatabaseNearFull fires above 400 MB.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max(pg_database_size_bytes{datname=\"postgres\"})",
          "editorMode": "code",
          "legendFormat": "postgres",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 400000000
              },
              {
                "color": "red",
                "value": 475000000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 500000000
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 9,
      "type": "alertlist",
      "title": "Firing alerts",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "description": "Grafana-managed alerts from observability/alerts.",
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 10,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "error": true,
          "normal": false
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Sessions, 24 h",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 17
      },
      "description": "Distinct Faro sessions from production in the last 24 hours.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "count(sum by (session_id) (count_over_time({app=\"house-manager\"} | logfmt | app_environment=\"production\" [24h])))",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "sessions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "JS errors, 24 h",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 17
      },
      "description": "Faro exceptions from production. Alert FrontendErrors fires above 10 in one hour.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({app=\"house-manager\"} |= \"kind=exception\" | logfmt | kind=\"exception\" | app_environment=\"production\" [24h])) or vector(0)",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Web vitals p75, 24 h",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "description": "p75 of the Core Web Vitals from production sessions. Good: LCP under 2500 ms, INP under 200 ms, CLS under 0.1.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "quantile_over_time(0.75, {app=\"house-manager\"} |= \"type=web-vitals\" | logfmt | kind=\"measurement\" | app_environment=\"production\" | lcp != \"\" | unwrap lcp [24h]) by (app_name)",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "LCP ms"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "quantile_over_time(0.75, {app=\"house-manager\"} |= \"type=web-vitals\" | logfmt | kind=\"measurement\" | app_environment=\"production\" | inp != \"\" | unwrap inp [24h]) by (app_name)",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "INP ms"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "quantile_over_time(0.75, {app=\"house-manager\"} |= \"type=web-vitals\" | logfmt | kind=\"measurement\" | app_environment=\"production\" | cls != \"\" | unwrap cls [24h]) by (app_name)",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "CLS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Free-tier budget (share of the monthly limit)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "description": "Monthly projection from the last 24 hours (active series: current). Alert FreeTierBudget fires above 80%.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          },
          "expr": "max(grafanacloud_instance_active_series) / 10000 or vector(0)",
          "editorMode": "code",
          "legendFormat": "Metrics: active series / 10k",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          },
          "expr": "sum(avg_over_time(grafanacloud_logs_instance_bytes_received_per_second[24h])) * 86400 * 30 / 50e9 or vector(0)",
          "editorMode": "code",
          "legendFormat": "Logs: projected GB / 50",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          },
          "expr": "sum(avg_over_time(grafanacloud_traces_instance_bytes_received_per_second[24h])) * 86400 * 30 / 50e9 or vector(0)",
          "editorMode": "code",
          "legendFormat": "Traces: projected GB / 50",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(count_over_time(probe_success[24h])) * 30 / 100000 or vector(0)",
          "editorMode": "code",
          "legendFormat": "Synthetic checks: projected executions / 100k",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "count(sum by (session_id) (count_over_time({app=\"house-manager\"} | logfmt [24h]))) * 30 / 50000 or vector(0)",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "Faro: projected sessions / 50k"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "minVizWidth": 8,
        "minVizHeight": 16
      }
    }
  ]
}
